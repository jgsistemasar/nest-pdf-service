<style>
  .footer-content {
    width: 100%;
    font-family: 'Azo Sans', Arial, sans-serif; /* Azo Sans para footer */
    color: #000;
    padding: 0;
    margin: 0;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    position: absolute; /* Pegado al borde */
    bottom: 0; /* Sin espacio inferior */
    left: 0;
  }

  .footer-main {
    width: calc(100% - 45mm);
    margin: 0 25mm 3mm 20mm; /* Márgenes para el contenido */
    padding: 2mm 0;
  }

  .footer-contact-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-size: 10px;
    line-height: 1.3;
    margin-bottom: 2mm;
  }

  .footer-left {
    flex: 1;
  }

  .footer-right {
    text-align: right;
    flex: 1;
  }

  .footer-lab-info {
    font-size: 9px;
    line-height: 1.25;
    margin-bottom: 2mm;
  }

  .footer-lab-info ul {
    margin: 0;
    padding-left: 4mm;
    list-style-type: disc; /* Viñetas redondas */
  }

  .footer-lab-info li {
    margin: 0;
    padding: 0;
  }

  .footer-strong {
    font-weight: 700;
  }

  .footer-center {
    text-align: center;
    margin: 2mm 0;
    font-size: 10px;
  }

  .footer-dup {
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    margin: 2mm 0;
    font-size: 11px;
  }

  .page-num {
    text-align: center;
    margin: 2mm 0;
    font-size: 9px;
  }

  .footer-color-bar {
    height: 8mm;
    width: 100%;
    display: flex;
    margin: 0; /* Pegada al borde inferior */
  }

  .color-section-orange {
    width: 10%;
    background-color: #f39c12;
  }

  .color-section-red {
    width: 90%;
    background-color: #84221f;
  }
</style>

<div class="footer-content">
  <div class="footer-main">
    <!-- Información del laboratorio -->
    <div class="footer-lab-info">
      <ul>
        <li>In compliance with OECD Principles of Good Laboratory Practices (No. 009)</li>
        <li>Registered into SENASA's National registry of certification bodies and surveyors of export grains and its subproducts (No. 016)</li>
        <li>Registered into SENASA's National Laboratories Network (No. LA0055 and LA0099)</li>
        <li>certificate senasa</li>
      </ul>
    </div>

    <!-- Lógica del duplicado -->
    {{#if duplicado}}
    <div class="footer-center">
      <div class="footer-strong">COPIA INFORMATIVA</div>
      <div>Este reporte se emite únicamente para ser presentado por el exportador ante las autoridades de</div>
      <div>SENASA en cumplimiento de la resolución 436/02</div>
    </div>
    <div class="footer-dup">DUPLICADO</div>
    {{else}}
    {{#if dsReporteResultados}}
    {{#with (lookup dsReporteResultados 0) as |p0|}}
    {{#if p0.duplicado}}
    <div class="footer-center">
      <div class="footer-strong">COPIA INFORMATIVA</div>
      <div>Este reporte se emite únicamente para ser presentado por el exportador ante las autoridades de</div>
      <div>SENASA en cumplimiento de la resolución 436/02</div>
    </div>
    <div class="footer-dup">DUPLICADO</div>
    {{/if}}
    {{/with}}
    {{/if}}
    {{/if}}

    <!-- Numeración de páginas -->
    <div class="page-num">Página <span class="pageNumber"></span> de <span class="totalPages"></span></div>
  </div>

  <!-- Barra de colores pegada al borde inferior -->
  <div class="footer-color-bar">
    <div class="color-section-orange"></div>
    <div class="color-section-red"></div>
  </div>
</div>
